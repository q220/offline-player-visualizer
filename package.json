{
  "name": "offline-player-visualizer",
  "version": "1.0.0",
  "description": "Visualize offline Minecraft player locations on a top-down block map with heatmap overlay",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server/index.ts -- ./world",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "@fastify/compress": "^8.0.1",
    "@fastify/cors": "^11.0.0",
    "@fastify/static": "^8.1.0",
    "debug": "^4.4.3",
    "fastify": "^5.2.1",
    "leaflet": "^1.9.4",
    "lru-cache": "^11.0.2",
    "minecraft-data": "^3.105.0",
    "prismarine-block": "^1.22.0",
    "prismarine-chunk": "^1.39.0",
    "prismarine-nbt": "^2.7.0",
    "prismarine-provider-anvil": "^2.11.0",
    "prismarine-registry": "^1.11.0",
    "sharp": "^0.33.2",
    "vec3": "^0.1.10"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.15",
    "@types/node": "^22.12.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
